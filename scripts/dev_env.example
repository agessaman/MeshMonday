APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
MESH_NAME=MeshCore
DICEBEAR_STYLE=adventurer
UI_POLL_SECONDS=15
IATA_DEFAULT=SEA
IATA_FILTERS=ALL
TRACK_FROM_DATE=2026-01-05
TZ=America/Los_Angeles
SQLITE_PATH=./data/meshmonday_dev.db
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_TOPIC_TEMPLATE=meshcore/+/+/packets
MQTT_CLIENT_ID=meshmonday-dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_MAX_PAYLOAD_BYTES=16384
INGEST_MAX_PACKET_HEX_CHARS=8192
INGEST_MAX_OBSERVER_KEY_CHARS=64
HASHTAG_CHANNELS=#meshmonday,#seattle,#bot
PRIVATE_CHANNEL_KEYS=
REPLAY_DELAY_MS=25
ENABLE_DEV_SEED=true
RAW_MONDAY_RETAIN_WEEKS=12
RETENTION_INTERVAL_MINUTES=60
